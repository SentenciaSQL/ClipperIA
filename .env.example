# AI Clipping Platform — environment template
# Copy to backend/.env or repository root .env and adjust values.

# Bind address (keep loopback for personal/local use)
ACP_HOST=127.0.0.1
ACP_PORT=8765

# development | production
ACP_ENVIRONMENT=development
ACP_DEBUG=true
ACP_LOG_LEVEL=INFO
ACP_LOG_JSON=false

# Optional: pin a stable local API token (otherwise generated each process start)
# ACP_API_TOKEN=replace-with-long-random-token

# Optional override for data root (defaults to Documents/AIClippingPlatform)
# ACP_DATA_ROOT=C:\Users\YourName\Documents\AIClippingPlatform

ACP_MAX_CONCURRENT_JOBS=2
ACP_MAX_GPU_INFERENCE_JOBS=1
