# AI Clipping Platform — environment template
# Copy to backend/.env or repository root .env and adjust values.

# Bind address (keep loopback for personal/local use)
ACP_HOST=127.0.0.1
ACP_PORT=8765

# development | production
ACP_ENVIRONMENT=development
ACP_DEBUG=true
ACP_LOG_LEVEL=INFO
ACP_LOG_JSON=false

# Optional: pin a stable local API token (otherwise generated each process start)
# ACP_API_TOKEN=replace-with-long-random-token

# Optional override for data root (defaults to Documents/AIClippingPlatform)
# ACP_DATA_ROOT=C:\Users\YourName\Documents\AIClippingPlatform

ACP_MAX_CONCURRENT_JOBS=2
ACP_MAX_GPU_INFERENCE_JOBS=1

# Local AI defaults
ACP_WHISPER_MODEL_SIZE=base
ACP_OLLAMA_BASE_URL=http://127.0.0.1:11434
ACP_OLLAMA_MODEL=qwen3:8b
ACP_AI_PROVIDER=local

# Highlight scoring weights
ACP_SCORE_AUDIO_INTENSITY=0.20
ACP_SCORE_VOICE_EMOTION=0.20
ACP_SCORE_SEMANTIC=0.25
ACP_SCORE_CHAT_ACTIVITY=0.15
ACP_SCORE_VISUAL_CHANGES=0.10
ACP_SCORE_NARRATIVE_QUALITY=0.10

ACP_DEFAULT_CLIP_DURATION=30
ACP_DEFAULT_ASPECT_RATIO=9:16

# Optional live platform OAuth credentials (never commit real secrets)
# ACP_YOUTUBE_CLIENT_ID=
# ACP_YOUTUBE_CLIENT_SECRET=
# ACP_TWITCH_CLIENT_ID=
# ACP_TWITCH_CLIENT_SECRET=
# ACP_KICK_CLIENT_ID=
# ACP_KICK_CLIENT_SECRET=
